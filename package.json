{
  "name": "fanhub-plus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --config client/vite.config.ts",
    "build": "tsc --noEmit -p client/tsconfig.json && vite build --config client/vite.config.ts",
    "start": "node server/start.js",
    "lint": "tsc --noEmit -p client/tsconfig.json",
    "data:migrate": "node scripts/migrate-sqlite-to-mongo.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "mongoose": "^9.10.2",
    "nodemailer": "^10.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "sanitize-html": "^2.17.7",
    "vite": "^8.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.0",
    "prisma": "^6.19.3",
    "typescript": "^5"
  }
}
