# ---------------------------------------------------------------------------
# Fan Hub Plus — environment template
# Copy to `.env` and fill in real values. `.env` is git-ignored; this file is
# committed so every required variable is documented.
# ---------------------------------------------------------------------------

# SQLite connection string. The database file itself is git-ignored.
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# ---------------------------------------------------------------------------

# Allows Auth.js to trust the host header behind a reverse proxy / hosting platform.
AUTH_TRUST_HOST=true

# Signing key for session cookies. MUST be replaced before deploying.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Absolute base URL of this deployment, no trailing slash.
# Password-reset links are built from this value, so it must be correct in
# production or reset emails will point at localhost.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Transactional email (SMTP / Nodemailer)
# Used for password-reset emails. When these are absent the app logs the reset
# link to the server console instead of sending mail, and says so explicitly.
# ---------------------------------------------------------------------------

# Gmail: smtp.gmail.com / 587. Other providers differ.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# For Gmail this must be a Google App Password, not the account password.
# https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASS=

# Sender shown in the "From" header. Some providers reject a From address that
# does not match the authenticated user.
MAIL_FROM=
