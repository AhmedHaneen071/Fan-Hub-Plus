# Fan Hub Plus MERN configuration. Copy to .env and replace values as needed.

# MongoDB local server used by Compass. The app uses 127.0.0.1 to avoid
# localhost resolving to IPv6 when MongoDB listens on IPv4 only.
MONGODB_URI=mongodb://127.0.0.1:27017/fanhubplus

# Required session signing key. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Local Express API and Vite browser client.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Optional SMTP settings; all are needed for actual password-reset delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Only needed by the one-way importer when moving an existing local SQLite DB.
DATABASE_URL=file:./dev.db
